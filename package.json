{
  "name": "tothemoon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive Three.js Earth→Moon spacecraft mission theater",
  "scripts": {
    "precompute": "tsx scripts/precompute-trajectory.ts && tsx scripts/precompute-flight13.ts",
    "precompute:moon": "tsx scripts/precompute-trajectory.ts",
    "precompute:flight13": "tsx scripts/precompute-flight13.ts",
    "horizons": "tsx scripts/fetch-horizons-epoch.ts",
    "horizons:flight13": "tsx scripts/fetch-horizons-epoch.ts --flight13",
    "starbase-surrounds": "tsx scripts/fetch-starbase-surrounds.ts",
    "starbase-naip": "tsx scripts/fetch-starbase-naip.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "lint:fix": "eslint src scripts --fix",
    "test": "tsx --test src/physics/*.test.ts src/mission/*.test.ts src/camera/*.test.ts src/ui/*.test.ts src/app/*.test.ts src/scene/*.test.ts src/debug/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=text-summary --include='src/**' --exclude='src/**/*.test.ts' --exclude='src/data/**' npm test",
    "build": "npm run precompute && npm run typecheck && vite build",
    "ci": "npm run typecheck && npm run lint && npm test",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "@types/three": "^0.178.0",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5"
  }
}
